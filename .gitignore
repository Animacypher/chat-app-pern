# ==============================================================================
# PERN Stack Chat Application - Root .gitignore
# Node.js / Express Backend + Vite / React Frontend
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Node Dependencies
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp/
.pnp.js

# ------------------------------------------------------------------------------
# 2. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
*.env
*.env.local

# Preserve example and template configurations for onboarding
!.env.example
!*.env.example
!.env.template
!*.env.template

# ------------------------------------------------------------------------------
# 3. Build Outputs, Bundles & Compilations
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
*.local
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.parcel-cache/
.turbo/

# ------------------------------------------------------------------------------
# 4. Local Uploads & User Files (Avatars, Attachments, Temp Storage)
# ------------------------------------------------------------------------------
# Ignore all uploaded files/media across root, backend, and frontend
uploads/*
!uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep
!**/uploads/**/.gitkeep

public/uploads/*
!public/uploads/.gitkeep
**/public/uploads/*
!**/public/uploads/.gitkeep
!**/public/uploads/**/.gitkeep

avatars/*
!avatars/.gitkeep
**/avatars/*
!**/avatars/.gitkeep
!**/avatars/**/.gitkeep

media/*
!media/.gitkeep
**/media/*
!**/media/.gitkeep
!**/media/**/.gitkeep

storage/*
!storage/.gitkeep
**/storage/*
!**/storage/.gitkeep
!**/storage/**/.gitkeep

temp/*
!temp/.gitkeep
**/temp/*
!**/temp/.gitkeep
!**/temp/**/.gitkeep

tmp/
**/tmp/
*.tmp

# ------------------------------------------------------------------------------
# 5. Logs & Debug Files
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 6. Database Dumps & Local Data (PostgreSQL, SQLite, Local Caches)
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.sql.dump
.cache/
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# 7. Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/

# ------------------------------------------------------------------------------
# 8. OS-Generated Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# 9. IDE & Editor Files
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.sublime-project
*.sublime-workspace

# Optional: To share team VS Code settings/extensions, comment out .vscode/ above and uncomment:
# .vscode/*
# !.vscode/settings.json
# !.vscode/extensions.json
# !.vscode/launch.json

# ------------------------------------------------------------------------------
# 10. Runtime & Process IDs
# ------------------------------------------------------------------------------
pids/
*.pid
*.seed
*.pid.lock
